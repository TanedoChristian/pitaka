# Copy to agent/.env and fill in. agent/.env is git-ignored.

# Your Pitaka app. Local dev: http://localhost:3100
PITAKA_URL=https://your-app.vercel.app

# Same value as INGEST_SECRET in Vercel / .env.local
INGEST_SECRET=

# Optional
# AGENT_MODEL=sonnet          # or opus for deeper research, haiku for cheaper
# AGENT_ANALYZE_MODEL=claude-opus-5-5   # model for the analyze task only
# AGENT_BUDGET_USD=3          # max spend per task per run
# CLAUDE_BIN=/home/you/.local/bin/claude
