# Supabase → Project → Connect → "Transaction pooler" connection string (port 6543).
# URL-encode special characters in the password (@ → %40, # → %23, / → %2F).
# Local dev: postgres://postgres:postgres@localhost:54329/postgres  (npm run db:up)
DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Password you type to log into the app
APP_PASSWORD=change-me-to-something-long

# Random string used to sign the login cookie (openssl rand -hex 32)
SESSION_SECRET=

# Shared secret the Google Apps Script sends to /api/ingest (openssl rand -hex 32)
INGEST_SECRET=
